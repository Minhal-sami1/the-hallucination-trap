# PostgreSQL connection used by the API, migrations, ingestion, verification, and evaluation.
DATABASE_URL=postgresql+psycopg://trap:trap@db:5432/hallucination_trap

# Optional Azure deployment password. The PowerShell deployment script reads it
# from the current process environment; it does not load this file. If it is
# empty, a first deployment generates a strong password. A rerun reuses the
# guarded Container Apps database secret, or rotates the password if that secret
# is unavailable. Set it only for an intentional password set or rotation.
# Never commit a non-empty value.
HALLITRAP_DB_PASSWORD=

# Optional. Enables live OpenAI answers. Cached seed replays and the local extractive grounded path work without it.
OPENAI_API_KEY=

# Optional Azure alternative to OPENAI_API_KEY. Set both Azure values to enable Azure OpenAI.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=

# Dense multilingual embedding model. FastEmbed downloads this Apache-2.0 model on first use.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2@faf4aa4225822f3bc6376869cb1164e8e3feedd0

# Cross-encoder model used after hybrid retrieval.
RERANKER_MODEL=onnx-community/gte-multilingual-reranker-base@ee64367e35a2db0da46bb6497e13a18f8bd585cb

# cached: replay committed, model-produced seed answers. live: call the configured LLM provider.
CACHE_MODE=cached

# LLM model used only when a provider key is present and live mode is selected.
OPENAI_MODEL=gpt-4.1-mini

# Minimum normalized retrieval confidence needed before the grounded generator can answer.
RETRIEVAL_CONFIDENCE_THRESHOLD=0.44

# Timeout in seconds for each explicit pipeline stage.
RETRIEVE_TIMEOUT_SECONDS=4
RANK_TIMEOUT_SECONDS=12
GENERATE_TIMEOUT_SECONDS=25
PARSE_TIMEOUT_SECONDS=2
VERIFY_TIMEOUT_SECONDS=2

# Browser-visible API origin used by the Vite development server.
VITE_API_BASE=http://localhost:8000

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Directory for downloaded FastEmbed model files. The compose file mounts a persistent volume here.
MODEL_CACHE_DIR=/models
